{
  "name": "avicola-api",
  "version": "1.0.0",
  "private": true,
  "description": "API del sistema de gestión — Avícola San Ángel (Etapa 1)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "db:generar": "typeorm-ts-node-commonjs migration:generate -d src/db/data-source.ts -p",
    "db:migrar": "typeorm-ts-node-commonjs migration:run -d src/db/data-source.ts",
    "db:seed": "ts-node src/db/seed.ts",
    "db:seed:prod": "node dist/db/seed.js"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3",
    "typescript": "5.9"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.10",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=20.12"
  }
}
